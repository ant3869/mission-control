{
  "name": "mission-control",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"api,vite\" -c \"cyan,magenta\" \"npm run server\" \"wait-on http://localhost:3001/api/health && vite\"",
    "server": "tsx watch --ignore data/ server/index.ts",
    "build": "vite build --emptyOutDir false",
    "preview": "vite preview",
    "test": "node --import tsx --test \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "test:mobile": "node --import tsx --test \"src/**/*.test.ts\"",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@google/design.md": "^0.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "lucide-react": "0.489.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supermemory": "^4.24.12",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.45",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "vite": "^5.4.3",
    "wait-on": "^9.0.4"
  }
}

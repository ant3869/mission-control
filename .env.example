# ─── Server ────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── Google Calendar ───────────────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com
# Enable the "Google Calendar API"
# Create an OAuth 2.0 Client ID (Application type: Web application)
# Set Authorized redirect URI to: http://localhost:3001/api/auth/google/callback
# Then paste your credentials below and visit http://localhost:3001/api/auth/google to connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Anthropic ─────────────────────────────────────────────────────────────────
# Your Anthropic API key from https://console.anthropic.com/settings/keys
# Required for Radar (token/cost analytics)
ANTHROPIC_API_KEY=

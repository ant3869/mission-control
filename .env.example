# ─── Server ────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── Google Calendar ───────────────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com
# Enable the "Google Calendar API"
# Create an OAuth 2.0 Client ID (Application type: Web application)
# Set Authorized redirect URI to: http://localhost:3001/api/auth/google/callback
# IMPORTANT: on the OAuth consent screen, click "Publish app" / set it to
#   "In production". While it is in "Testing" mode Google EXPIRES the refresh
#   token after 7 days — the #1 cause of repeated re-auth.
# Then set the two values below and connect from Settings → Google (or visit
#   http://localhost:3001/api/auth/google). The refresh token is stored
#   automatically in data/google-tokens.json and refreshed in the background —
#   no copy-paste, no server restart.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional overrides:
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# APP_URL=http://localhost:5173
# GOOGLE_REFRESH_TOKEN=   # legacy/optional — if set, it is imported into the
#                         # token store on first run, then maintained there.

# ─── Anthropic ─────────────────────────────────────────────────────────────────
# Your Anthropic API key from https://console.anthropic.com/settings/keys
# Required for Radar (token/cost analytics)
ANTHROPIC_API_KEY=

# ─── Agent platforms (OpenClaw / Hermes) ───────────────────────────────────────
# These are OPTIONAL seed values — you can also configure everything from the
# Settings view in the UI (stored in data/connectors.json, git-ignored).
#
# Gateway base URL + token to PULL live sessions, agents, cron jobs & analytics
# from the platform's dashboard REST API.
#   OpenClaw gateway control UI default ≈ http://127.0.0.1:18789
#   Hermes   web dashboard default      ≈ http://127.0.0.1:9119
OPENCLAW_BASE_URL=
OPENCLAW_TOKEN=
HERMES_BASE_URL=
HERMES_TOKEN=

# Bearer tokens that secure the inbound PUSH webhooks (POST /api/openclaw/events,
# POST /api/hermes/events). Leave blank to accept unauthenticated pushes.
OPENCLAW_PUSH_TOKEN=
HERMES_PUSH_TOKEN=

# ─── OpenClaw memory over SSH ───────────────────────────────────────────────────
# The agent's real memory system (daily logs, dreaming pipeline, LanceDB recall)
# lives on the agent machine and is read live over SSH. Set these to YOUR host —
# never commit real values (this file is the template; put real ones in .env).
#   OPENCLAW_SSH_KEY may be an absolute path or a key name resolved under ~/.ssh
OPENCLAW_SSH_HOST=
OPENCLAW_SSH_USER=
OPENCLAW_SSH_KEY=
# Optional: remote memory dir relative to the agent user's home
# OPENCLAW_MEMORY_SUBDIR=.openclaw/workspace/memory

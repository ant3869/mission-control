# ─── Server ────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── Mobile / Android (Capacitor) ─────────────────────────────────────────────
# Required when building the Android or iOS app.
#
# STEP 1 — Find your PC's local IP address:
#   Windows: open Command Prompt → run: ipconfig
#            look for "IPv4 Address" under your Wi-Fi adapter, e.g. 192.168.1.100
#
# STEP 2 — Set it here (keep port 3001, or whatever API_PORT is set to above):
#   VITE_API_BASE_URL=http://192.168.1.100:3001
#
# STEP 3 — Make sure your PC firewall allows inbound connections on port 3001.
#   Windows Defender: Control Panel → Firewall → Advanced Settings →
#   Inbound Rules → New Rule → Port → TCP → 3001 → Allow
#
# STEP 4 — Build and open in Android Studio:
#   npm run cap:android
#
# Your phone must be on the same Wi-Fi network as your PC.
# Leave blank for normal web/browser usage — relative /api paths are used instead.
VITE_API_BASE_URL=

# ─── Google Calendar ───────────────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com
# Enable the "Google Calendar API"
# Create an OAuth 2.0 Client ID (Application type: Web application)
# Set Authorized redirect URI to: http://localhost:3001/api/auth/google/callback
# IMPORTANT: on the OAuth consent screen, click "Publish app" / set it to
#   "In production". While it is in "Testing" mode Google EXPIRES the refresh
#   token after 7 days — the #1 cause of repeated re-auth.
# Then set the two values below and connect from Settings → Google (or visit
#   http://localhost:3001/api/auth/google). The refresh token is stored
#   automatically in data/google-tokens.json and refreshed in the background —
#   no copy-paste, no server restart.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional overrides:
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# APP_URL=http://localhost:5173
# GOOGLE_REFRESH_TOKEN=   # legacy/optional — if set, it is imported into the
#                         # token store on first run, then maintained there.

# ─── Anthropic ─────────────────────────────────────────────────────────────────
# Your Anthropic API key from https://console.anthropic.com/settings/keys
# Required for Radar (token/cost analytics)
ANTHROPIC_API_KEY=

# ─── Agent platforms (OpenClaw / Hermes) ───────────────────────────────────────
# These are OPTIONAL seed values — you can also configure everything from the
# Settings view in the UI (stored in data/connectors.json, git-ignored).
#
# Gateway base URL + token to PULL live sessions, agents, cron jobs & analytics
# from the platform's dashboard REST API.
#   OpenClaw gateway control UI default ≈ http://127.0.0.1:18789
#   Hermes   web dashboard default      ≈ http://127.0.0.1:9119
OPENCLAW_BASE_URL=
OPENCLAW_TOKEN=
# Agent name used when reading memory files via agents.files.list / agents.files.get.
# Defaults to 'main'. To find your agent's name, check the Activity → Agents tab
# in Mission Control while connected to OpenClaw — the name column is the value to use.
OPENCLAW_AGENT_ID=main
HERMES_BASE_URL=
HERMES_TOKEN=

# Bearer tokens that secure the inbound PUSH webhooks (POST /api/openclaw/events,
# POST /api/hermes/events). Leave blank to accept unauthenticated pushes.
OPENCLAW_PUSH_TOKEN=
HERMES_PUSH_TOKEN=

# ─── Discord bot (inbound commands → Mission Control) ──────────────────────────
# Create a bot at https://discord.com/developers/applications
#   → New Application → Bot → Reset Token → copy the token below
# Required Gateway Intents (under Bot → Privileged Gateway Intents):
#   ✅ MESSAGE CONTENT INTENT
# Bot permissions needed: Read Messages/View Channels, Send Messages, Read Message History
# Add the bot to your server with scope: bot  (permissions: 2048 + 65536)
#
# You can reuse an existing bot token (e.g. from OpenClaw/Hermes) if that bot
# is in the same server — just add the MESSAGE CONTENT intent to it.
DISCORD_BOT_TOKEN=
# Comma-separated list of channel IDs the bot will respond to (commands).
# Leave blank to allow any channel the bot can see.
DISCORD_CHANNEL_IDS=
# Comma-separated Discord user IDs allowed to issue commands (empty = any user in allowed channels):
DISCORD_ALLOWED_USER_IDS=
# Single channel ID for proactive push notifications (approvals, research done,
# due-date reminders, agent alerts). Leave blank to disable push notifications.
DISCORD_NOTIFY_CHANNEL_ID=

# ─── OpenClaw memory over SSH ───────────────────────────────────────────────────
# The agent's real memory system (daily logs, dreaming pipeline, LanceDB recall)
# lives on the agent machine and is read live over SSH. Set these to YOUR host —
# never commit real values (this file is the template; put real ones in .env).
#   OPENCLAW_SSH_KEY may be an absolute path or a key name resolved under ~/.ssh
OPENCLAW_SSH_HOST=
OPENCLAW_SSH_USER=
OPENCLAW_SSH_KEY=
# Optional: remote memory dir relative to the agent user's home
# OPENCLAW_MEMORY_SUBDIR=.openclaw/workspace/memory
